<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dashboard"
        android:textColor="@color/text"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="2">

        <TextView
            android:id="@+id/cardMessages"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="6dp"
            android:background="@color/card"
            android:padding="18dp"
            android:text="💬 SMS Logs"
            android:textColor="@color/text"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cardScreenTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="6dp"
            android:background="@color/card"
            android:padding="18dp"
            android:text="⏱ Screen Time"
            android:textColor="@color/text"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cardGeofence"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="6dp"
            android:background="@color/card"
            android:padding="18dp"
            android:text="📍 Safe Zones"
            android:textColor="@color/text"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cardBrowserHistory"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="6dp"
            android:background="@color/card"
            android:padding="18dp"
            android:text="🌐 Web History"
            android:textColor="@color/text"
            android:textStyle="bold" />

    </GridLayout>
</LinearLayout>
